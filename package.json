{
  "name": "zamp-ap-agent",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "next build apps/web",
    "db:reset": "SUPABASE_TELEMETRY_DISABLED=1 supabase db reset --local",
    "db:test": "SUPABASE_TELEMETRY_DISABLED=1 supabase test db --local supabase/tests/database",
    "demo:reset": "node scripts/reset-demo.mjs",
    "db:seed": "node scripts/reset-demo.mjs",
    "extract:invoice": "tsx scripts/extract-invoice.ts",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "dev": "node --env-file-if-exists=.env.local node_modules/next/dist/bin/next dev apps/web"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.76.1",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.34.5",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "tsx": "4.21.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
