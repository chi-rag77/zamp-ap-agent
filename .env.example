# Server-only database access. Never prefix the service role key with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WorkOS AuthKit. Production auth stays disabled until Supabase third-party auth,
# the WorkOS JWT template, and the tenant-isolation migration are verified.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=
ZAMP_AUTH_REQUIRED=false
ZAMP_TENANT_ISOLATION_READY=false
ZAMP_WORKOS_ORGANIZATION_ID=org_...

# NVIDIA NIM (server only). Real mode is the default.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_REQUEST_TIMEOUT_MS=90000
NVIDIA_MAX_OUTPUT_TOKENS=8192
NVIDIA_MAX_ATTEMPTS=3
NVIDIA_JSON_MODE=false
MAX_INVOICE_FILE_SIZE_MB=20
MAX_INVOICE_PAGES=20
EXTRACTION_API_TOKEN=
APP_ENV=development

# Gmail OAuth settings. On Vercel, enable Vercel Authentication for all deployments
# and set ZAMP_ENABLE_PROTECTED_WORKSPACE=true. The callback stores the refresh token
# in a server-only Supabase table; GMAIL_REFRESH_TOKEN is an optional local override.
ZAMP_ENABLE_PROTECTED_WORKSPACE=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=
GMAIL_INVOICE_MAILBOX=
GMAIL_INTAKE_QUERY=in:inbox newer_than:30d
# Gmail watch topic and authenticated Pub/Sub push subscription.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
EMAIL_ADMIN_TOKEN=
SUPABASE_STORAGE_BUCKET=invoice-documents
EMAIL_MAX_ATTACHMENT_SIZE_MB=15
EMAIL_MAX_CONCURRENT_ATTACHMENTS=3
# Optional transactional email delivery for assigned work and @mentions.
# Store RESEND_API_KEY as a server-side secret; use a sender verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=
AGENT_AUTO_TRIGGER=true
AGENT_WORKER_SECRET=
VERCEL_AUTOMATION_BYPASS_SECRET=
